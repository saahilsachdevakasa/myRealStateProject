<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>On Booking creation, reassign OwnerId to the Post-Sales Queue. Per Phase 1 Architecture Section 5.3 — bookings are owned by Post-Sales from inception; round-robin assignment to a specific Post_Sales_Exec ships in a later epic.</description>
    <environments>Default</environments>
    <interviewLabel>Transfer Booking To Post Sales Queue {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Transfer Booking To Post Sales Queue</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Post_Sales_Queue</name>
        <label>Get Post-Sales Queue</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Booking_Owner</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Post_Sales_Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Booking_Owner</name>
        <label>Update Booking Owner</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Post_Sales_Queue.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Post_Sales_Queue</targetReference>
        </connector>
        <object>Booking__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
