<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Record-Triggered Flow on Account (BeforeSave). When CP_Status__c changes: on transition to Active, populate Empanelment_Date, Approval_Date, and Approved_By if blank; on transition to Suspended or Terminated, disable Portal_Access. Per Phase 1 Architecture Section 10.2 — CP registration / status workflow.</description>
    <environments>Default</environments>
    <interviewLabel>CP Status Change Handler {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CP Status Change Handler</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <assignments>
        <name>Set_Activation_Fields</name>
        <label>Set Activation Fields</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>$Record.Empanelment_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Empanelment_Date_Resolved</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Approval_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Approval_Date_Resolved</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Approved_By__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Approved_By_Resolved</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Disable_Portal_Access</name>
        <label>Disable Portal Access</label>
        <locationX>440</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>$Record.Portal_Access__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Status_Decision</name>
        <label>Route by New Status</label>
        <locationX>308</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Status_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CP_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Activation_Fields</targetReference>
            </connector>
            <label>Active</label>
        </rules>
        <rules>
            <name>Status_Inactive</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CP_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Suspended</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CP_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Terminated</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Disable_Portal_Access</targetReference>
            </connector>
            <label>Suspended or Terminated</label>
        </rules>
    </decisions>
    <formulas>
        <name>Empanelment_Date_Resolved</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!$Record.Empanelment_Date__c}), TODAY(), {!$Record.Empanelment_Date__c})</expression>
    </formulas>
    <formulas>
        <name>Approval_Date_Resolved</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!$Record.Approval_Date__c}), TODAY(), {!$Record.Approval_Date__c})</expression>
    </formulas>
    <formulas>
        <name>Approved_By_Resolved</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Approved_By__c}), {!$User.Id}, {!$Record.Approved_By__c})</expression>
    </formulas>
    <start>
        <locationX>182</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Status_Decision</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.CP_Status__c})</filterFormula>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
</Flow>
